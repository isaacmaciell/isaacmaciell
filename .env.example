# Credenciais de integração do Artia (Configurações > Integrações > API)
ARTIA_CLIENT_ID=
ARTIA_CLIENT_SECRET=
# ID da organização (cabeçalho OrganizationId exigido pela API)
ARTIA_ORGANIZATION_ID=
# Opcional: ID do grupo de trabalho (accountId) padrão usado pelas ferramentas
ARTIA_ACCOUNT_ID=
# Opcional: endpoint GraphQL (padrão: https://app.artia.com/graphql)
ARTIA_API_URL=https://app.artia.com/graphql
# Opcional: seu e-mail no Artia (usado por artia_list_my_open_activities)
ARTIA_USER_EMAIL=
